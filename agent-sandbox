#!/usr/bin/env bash
set -euo pipefail

SUPPORTED_AGENTS="claude, pi, codex, gemini, aider"

usage() {
    echo "Usage: agent-sandbox <agent> [--profile NAME] [--shared-history] [AGENT_ARGS...]"
    echo "       agent-sandbox <agent> --exec CMD [ARGS...]"
    echo "       agent-sandbox --build"
    echo ""
    echo "Agents: ${SUPPORTED_AGENTS}"
}

# Resolve agent config from name
resolve_agent() {
    case "$1" in
        claude) AGENT_INSTALL='curl -fsSL https://claude.ai/install.sh | bash -s latest'
                AGENT_BIN='$HOME/.local/bin/claude'
                AGENT_CONFIG_DIR=".claude"
                AGENT_CONTEXT_FILE=".claude/CLAUDE.md" ;;
        pi)     AGENT_INSTALL='curl -fsSL https://pi.dev/install.sh | sh'
                AGENT_BIN='$HOME/.local/bin/pi'
                AGENT_CONFIG_DIR=".pi/agent"
                AGENT_CONTEXT_FILE=".pi/agent/AGENTS.md" ;;
        codex)  AGENT_INSTALL='npm install -g --prefix "$HOME/.local" @openai/codex'
                AGENT_BIN='$HOME/.local/bin/codex'
                AGENT_CONFIG_DIR=".codex"
                AGENT_CONTEXT_FILE=".codex/AGENTS.md" ;;
        gemini) AGENT_INSTALL='npm install -g --prefix "$HOME/.local" @google/gemini-cli'
                AGENT_BIN='$HOME/.local/bin/gemini'
                AGENT_CONFIG_DIR=".gemini"
                AGENT_CONTEXT_FILE=".gemini/GEMINI.md" ;;
        aider)  AGENT_INSTALL='uv tool install aider-chat'
                AGENT_BIN='$HOME/.local/bin/aider'
                AGENT_CONFIG_DIR=".aider"
                AGENT_CONTEXT_FILE="" ;;
        *)      echo "Unknown agent: $1" >&2
                echo "Supported: ${SUPPORTED_AGENTS}" >&2
                exit 1 ;;
    esac
}

SANDBOX_BASE="${HOME}/.agent-sandbox"
SANDBOX_SIF="${SANDBOX_BASE}/agent-sandbox.sif"
SCRIPT_DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"

# Build container
build_container() {
    echo "Building agent sandbox container..."
    mkdir -p "${SANDBOX_BASE}"

    if ! apptainer build --fix-perms "${SANDBOX_SIF}" "${SCRIPT_DIR}/agent-sandbox.def" 2>/dev/null; then
        echo "Trying with --fakeroot..."
        if ! apptainer build --fakeroot "${SANDBOX_SIF}" "${SCRIPT_DIR}/agent-sandbox.def" 2>/dev/null; then
            echo "Trying with --fakeroot --ignore-fakeroot-command..."
            apptainer build --fakeroot --ignore-fakeroot-command "${SANDBOX_SIF}" "${SCRIPT_DIR}/agent-sandbox.def"
        fi
    fi
    echo "Container built: ${SANDBOX_SIF}"
}

# Handle --build and --help first (they don't need an agent name)
case "${1:-}" in
    --build) build_container; exit 0 ;;
    --help|-h) usage; exit 0 ;;
esac

# Backwards compat: "claude-sandbox" invocation implies agent=claude
SCRIPT_NAME=$(basename "$0")
if [ "${SCRIPT_NAME}" = "claude-sandbox" ]; then
    AGENT="claude"
else
    AGENT="${1:-}"
    [ -z "${AGENT}" ] && { usage; exit 0; }
    shift
fi
resolve_agent "${AGENT}"

SANDBOX_HOME="${SANDBOX_BASE}/homes/${AGENT}"

# Transcript pool shared across profiles when --shared-history is set
SANDBOX_SHARED_PROJECTS="${SANDBOX_BASE}/shared/${AGENT}/projects"

# Per-user tmp base directory (avoid conflicts with other users)
SANDBOX_TMP_BASE="/tmp/agent-sandbox-${UID}"

# Instance-specific tmp directory (set in run_container)
SANDBOX_TMP=""

# Cleanup temp directory on exit
cleanup() {
    if [ -n "${SANDBOX_TMP}" ] && [ -d "${SANDBOX_TMP}" ]; then
        rm -rf "${SANDBOX_TMP}"
        # Remove base dir if empty (ignore failure if other instances exist)
        rmdir "${SANDBOX_TMP_BASE}" 2>/dev/null || true
    fi
}
trap cleanup EXIT

# Initialize persistent home directory
init_sandbox_home() {
    mkdir -p "${SANDBOX_HOME}"/{.local/bin,.local/share/uv,.config}
    mkdir -p "${SANDBOX_HOME}/${AGENT_CONFIG_DIR}"

    if [ ! -f "${SANDBOX_HOME}/.bash_profile" ]; then
        echo '[ -f ~/.bashrc ] && . ~/.bashrc' > "${SANDBOX_HOME}/.bash_profile"
    fi

    if [ ! -f "${SANDBOX_HOME}/.tmux.conf" ]; then
        echo 'set -g extended-keys on' > "${SANDBOX_HOME}/.tmux.conf"
    fi

    if [ ! -f "${SANDBOX_HOME}/.bashrc" ]; then
        cat > "${SANDBOX_HOME}/.bashrc" << 'BASHRC'
export PATH="$HOME/.local/bin:$PATH"
export UV_TOOL_DIR="$HOME/.local/share/uv/tools"
export UV_TOOL_BIN_DIR="$HOME/.local/bin"
export UV_PROJECT_ENVIRONMENT=.venv-sandbox
BASHRC
    fi

    # Claude-specific: install claude-monitor on first run
    if [ "${AGENT}" = claude ] && ! grep -q claude-monitor "${SANDBOX_HOME}/.bashrc"; then
        cat >> "${SANDBOX_HOME}/.bashrc" << 'BASHRC'

# Install claude-monitor on first run
if ! command -v claude-monitor &> /dev/null; then
    echo "Installing claude-monitor..."
    uv tool install claude-monitor 2>/dev/null || true
fi
BASHRC
    fi
}

# Sandbox-awareness note injected into the agent's global context file.
# Kept in sync on every run; keep this text consistent with the bind mounts
# and security model in run_container (and README/CLAUDE.md).
sandbox_context_note() {
    cat << 'NOTE'
<!-- This section is auto-generated by agent-sandbox on every launch. Manual
     edits inside the agent-sandbox markers are overwritten on the next run;
     keep your own notes outside the markers. -->

## Agent Sandbox Environment

You are running inside **agent-sandbox**, an isolated Apptainer container. This
applies in **every** working directory, not just specific projects. Detection:
`SINGULARITY_CONTAINER` is set and `HOME=/home/sandbox`.

- **Writable**: the current working directory (a real host directory, bind-mounted
  — changes persist on the host, treat it with care) and this home directory
  (`/home/sandbox`, persisted per agent/profile at `~/.agent-sandbox/homes/<agent>[-<profile>]/`).
  If present: `~/.julia/` and `~/R/` (shared with the host).
- **Read-only**: Julia binaries, `~/.local/share/uv/python/`, and (Claude only)
  host `~/.claude/skills/` and `~/.claude/plugins/`.
- **No host secrets**: no SSH keys, AWS credentials, or host environment
  variables. Use `gh` (authenticated via an ephemeral credentials copy) for
  git remotes/GitHub; SSH pushes will not work.
- **Ephemeral**: anything installed outside the persisted home is lost on exit.
- **Git identity** is injected from the host via `GIT_AUTHOR_*`/`GIT_COMMITTER_*`
  environment variables — commits work normally.
- **Python**: use `uv`; project environments go in `.venv-sandbox/` (not `.venv/`)
  to avoid clashing with host projects.

Full details: the README of the agent-sandbox project.
NOTE
}

# Upsert the sandbox note into the agent's global context file, delimited by
# markers. Existing content outside the markers is preserved; the section is
# replaced (never duplicated) on each run.
CONTEXT_BEGIN='<!-- agent-sandbox:begin -->'
CONTEXT_END='<!-- agent-sandbox:end -->'

sync_context_file() {
    local file="$1"
    local note; note=$(sandbox_context_note)
    mkdir -p "$(dirname "${file}")"

    if [ ! -f "${file}" ]; then
        printf '%s\n\n%s\n\n%s\n' "${CONTEXT_BEGIN}" "${note}" "${CONTEXT_END}" > "${file}"
    elif grep -qF "${CONTEXT_BEGIN}" "${file}" && grep -qF "${CONTEXT_END}" "${file}"; then
        awk -v begin="${CONTEXT_BEGIN}" -v end="${CONTEXT_END}" -v note="${note}" '
            $0 == begin { print; print ""; print note; print ""; skip=1; next }
            $0 == end   { skip=0; print; next }
            !skip
        ' "${file}" > "${file}.tmp" && mv "${file}.tmp" "${file}"
    else
        # No (complete) section yet: append once
        printf '\n%s\n\n%s\n\n%s\n' "${CONTEXT_BEGIN}" "${note}" "${CONTEXT_END}" >> "${file}"
    fi
}

# Detect Julia installation path
detect_julia() {
    local julia_bin julia_home
    julia_bin=$(which julia 2>/dev/null) || true
    if [ -n "${julia_bin}" ]; then
        julia_home=$(dirname "$(dirname "$(readlink -f "${julia_bin}")")")
        # Skip system-installed Julia to avoid shadowing container's /usr
        if [ "${julia_home}" != "/usr" ] && [ "${julia_home}" != "/usr/local" ]; then
            echo "${julia_home}"
            return
        fi
    fi

    # Fallback: ask Julia for its actual location (handles juliaup wrappers)
    if command -v julia &>/dev/null; then
        julia_home=$(julia --startup-file=no -e 'println(dirname(Sys.BINDIR))' 2>/dev/null) || true
        if [ -n "${julia_home}" ] && [ -x "${julia_home}/bin/julia" ]; then
            echo "${julia_home}"
        fi
    fi
}

# Run container
run_container() {
    [ ! -f "${SANDBOX_SIF}" ] && { echo "Run 'agent-sandbox --build' first"; exit 1; }
    init_sandbox_home
    # Keep the agent's global context file aware of the sandbox (idempotent)
    [ -n "${AGENT_CONTEXT_FILE:-}" ] && sync_context_file "${SANDBOX_HOME}/${AGENT_CONTEXT_FILE}"

    # Create per-instance temp directory (cleaned up on exit via trap)
    mkdir -p "${SANDBOX_TMP_BASE}"
    chmod 700 "${SANDBOX_TMP_BASE}"  # Restrict to owner only
    SANDBOX_TMP=$(mktemp -d "${SANDBOX_TMP_BASE}/instance.XXXXXX")

    local OPTS=(
        --containall --cleanenv --userns --nv
        --home "${SANDBOX_HOME}:/home/sandbox"
        --pwd "$(pwd)"
        --bind "${SANDBOX_TMP}:/tmp"
    )

    # Working directory bind is added later (after Julia binds) to ensure
    # it takes precedence when working inside ~/.julia/

    # Shared conversation transcripts across profiles (opt-in). Bound over the
    # home so each profile keeps its own credentials/config but pools sessions.
    # Session history is keyed by the working directory path, which is identical
    # across profiles, so the same project resolves to the same transcripts.
    if [ "${SHARED_HISTORY:-}" = true ] && [ "${AGENT}" = claude ]; then
        mkdir -p "${SANDBOX_SHARED_PROJECTS}"
        mkdir -p "${SANDBOX_HOME}/.claude/projects"
        OPTS+=(--bind "${SANDBOX_SHARED_PROJECTS}:/home/sandbox/.claude/projects")
    fi

    # GitHub CLI credentials (copy to writable temp location - gh needs write access for migrations)
    if [ -d "${HOME}/.config/gh" ]; then
        mkdir -p "${SANDBOX_TMP}/.config/gh"
        cp -r "${HOME}/.config/gh/"* "${SANDBOX_TMP}/.config/gh/"
        OPTS+=(--env "GH_CONFIG_DIR=/tmp/.config/gh")
    fi

    # Julia packages and installation
    # Bind to sandbox home for normal access, AND to original host path so
    # hardcoded paths in precompiled cache/deps files still work
    if [ -d "${HOME}/.julia" ]; then
        OPTS+=(--bind "${HOME}/.julia:/home/sandbox/.julia")
        # Also expose at original host path so hardcoded paths in precompilation
        # cache/deps files still resolve (e.g., PyCall conda, artifact paths)
        [ "${HOME}" != "/home/sandbox" ] && OPTS+=(--bind "${HOME}/.julia:${HOME}/.julia")
    fi
    local julia_home; julia_home=$(detect_julia)
    # Only bind Julia install if it's not already under ~/.julia/ (which is already bound)
    if [ -n "${julia_home}" ] && [[ "${julia_home}" != "${HOME}/.julia/"* ]]; then
        OPTS+=(--bind "${julia_home}:${julia_home}:ro")
    fi

    # R user library (for persistent R packages across container runs)
    [ -d "${HOME}/R" ] && OPTS+=(--bind "${HOME}/R:/home/sandbox/R")

    # UV Python installations (for PyCall and other Python-dependent Julia packages)
    [ -d "${HOME}/.local/share/uv/python" ] && OPTS+=(--bind "${HOME}/.local/share/uv/python:${HOME}/.local/share/uv/python:ro")

    # Claude-specific: host skills and plugins (read-only)
    if [ "${AGENT}" = claude ]; then
        if [ -d "${HOME}/.claude/skills" ]; then
            mkdir -p "${SANDBOX_HOME}/.claude/skills"
            OPTS+=(--bind "${HOME}/.claude/skills:/home/sandbox/.claude/skills:ro")
        fi
        if [ -d "${HOME}/.claude/plugins" ]; then
            mkdir -p "${SANDBOX_HOME}/.claude/plugins"
            OPTS+=(--bind "${HOME}/.claude/plugins:/home/sandbox/.claude/plugins:ro")
        fi
    fi

    # Working directory - added after Julia binds so it takes precedence when inside ~/.julia/
    OPTS+=(--bind "$(pwd):$(pwd)")

    # Environment variables
    OPTS+=(--env "TERM=${TERM:-xterm-256color}")
    OPTS+=(--env "UV_PROJECT_ENVIRONMENT=.venv-sandbox")
    OPTS+=(--env 'PS1=\[\e[1;32m\]\u\[\e[0m\]:\[\e[1;34m\]\w\[\e[0m\]\$ ')

    local git_name git_email
    git_name=$(git config --global user.name 2>/dev/null) || true
    git_email=$(git config --global user.email 2>/dev/null) || true
    [ -n "${git_name}" ] && OPTS+=(--env "GIT_AUTHOR_NAME=${git_name}" --env "GIT_COMMITTER_NAME=${git_name}")
    [ -n "${git_email}" ] && OPTS+=(--env "GIT_AUTHOR_EMAIL=${git_email}" --env "GIT_COMMITTER_EMAIL=${git_email}")

    # Set PATH (include Julia if detected)
    local container_path="/home/sandbox/.local/bin:/usr/local/bin:/usr/bin:/bin"
    if [ -n "${julia_home}" ]; then
        # Translate juliaup paths (under ~/.julia/) to the container home
        if [[ "${julia_home}" == "${HOME}/.julia/"* ]]; then
            container_path="/home/sandbox/.julia${julia_home#"${HOME}/.julia"}/bin:${container_path}"
        else
            container_path="${julia_home}/bin:${container_path}"
        fi
    fi
    OPTS+=(--env "PATH=${container_path}")

    # Pass agent config to container
    OPTS+=(--env "AGENT_NAME=${AGENT}")
    OPTS+=(--env "AGENT_INSTALL=${AGENT_INSTALL}")
    OPTS+=(--env "AGENT_BIN=${AGENT_BIN}")

    if [ "${EXEC_MODE:-}" = true ]; then
        # Exec mode: run arbitrary command inside the container.
        # Ensure agent CLI is installed first (normally done by runscript).
        # Installation output goes to stderr to keep stdin/stdout clean for
        # protocols like ACP that communicate over stdio.
        exec apptainer exec "${OPTS[@]}" "${SANDBOX_SIF}" bash -c '
            RESOLVED_BIN=$(eval echo "${AGENT_BIN}")
            if [ ! -x "${RESOLVED_BIN}" ]; then
                echo "Installing ${AGENT_NAME}..." >&2
                eval "${AGENT_INSTALL}" >&2
            fi
            exec "$@"
        ' _ "$@"
    else
        exec apptainer run "${OPTS[@]}" "${SANDBOX_SIF}" "$@"
    fi
}

# Parse remaining options (agent name already consumed)
PROFILE=""
SHARED_HISTORY=false
EXEC_MODE=false

while [ $# -gt 0 ]; do
    case "$1" in
        --exec) EXEC_MODE=true; shift; break ;;
        --profile) PROFILE="${2:-}"; shift 2 ;;
        --profile=*) PROFILE="${1#*=}"; shift ;;
        --shared-history) SHARED_HISTORY=true; shift ;;
        --help|-h) usage; exit 0 ;;
        *) break ;;
    esac
done

# Resolve profile -> dedicated persistent home (isolated login + config + history)
if [ -n "${PROFILE}" ]; then
    if [[ ! "${PROFILE}" =~ ^[a-zA-Z0-9_-]+$ ]]; then
        echo "Invalid profile name: '${PROFILE}' (use letters, digits, '-' or '_')" >&2
        exit 1
    fi
    SANDBOX_HOME="${SANDBOX_BASE}/homes/${AGENT}-${PROFILE}"
fi

# Backwards compat: detect legacy directories
if [ "${AGENT}" = claude ]; then
    if [ -n "${PROFILE}" ]; then
        LEGACY_HOME="${HOME}/.claude-sandbox-home-${PROFILE}"
    else
        LEGACY_HOME="${HOME}/.claude-sandbox-home"
    fi
    if [ -d "${LEGACY_HOME}" ]; then
        echo "WARNING: Legacy home directory detected. Please migrate:" >&2
        [ ! -d "$(dirname "${SANDBOX_HOME}")" ] && echo "  mkdir -p $(dirname "${SANDBOX_HOME}")" >&2
        echo "  mv ${LEGACY_HOME} ${SANDBOX_HOME}" >&2
        SANDBOX_HOME="${LEGACY_HOME}"
    fi
    LEGACY_SHARED="${HOME}/.claude-sandbox-shared/projects"
    if [ -d "${LEGACY_SHARED}" ]; then
        echo "WARNING: Legacy shared history detected. Please migrate:" >&2
        [ ! -d "$(dirname "${SANDBOX_SHARED_PROJECTS}")" ] && echo "  mkdir -p $(dirname "${SANDBOX_SHARED_PROJECTS}")" >&2
        echo "  mv ${LEGACY_SHARED} ${SANDBOX_SHARED_PROJECTS}" >&2
        SANDBOX_SHARED_PROJECTS="${LEGACY_SHARED}"
    fi
fi

run_container "$@"
